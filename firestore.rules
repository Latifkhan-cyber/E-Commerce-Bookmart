rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    function isNotBlocked() {
      return isAuthenticated() && getUserData().isBlocked != true;
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Anyone authenticated can read basic user profile if owner or admin
      allow read: if isOwner(userId) || isAdmin();
      // Registration: user creates their own doc; role must be 'CUSTOMER' unless created by an admin
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == 'CUSTOMER') || isAdmin()
      );
      // Update: user can update own profile fields, but CANNOT modify their own role or isBlocked status
      allow update: if (
        isOwner(userId) && 
        isNotBlocked() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked'])
      ) || isAdmin();
      // Delete: admin only
      allow delete: if isAdmin();
    }

    // BOOKS COLLECTION
    match /books/{bookId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isAdmin();
    }

    // CATEGORIES COLLECTION
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // AUTHORS COLLECTION
    match /authors/{authorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // PUBLISHERS COLLECTION
    match /publishers/{publisherId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // CARTS COLLECTION
    match /carts/{cartId} {
      allow read, write: if isOwner(cartId) && isNotBlocked();
    }

    // WISHLISTS COLLECTION
    match /wishlists/{wishlistId} {
      allow read, write: if isOwner(wishlistId) && isNotBlocked();
    }

    // ADDRESSES COLLECTION
    match /addresses/{addressId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isNotBlocked();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ORDERS COLLECTION
    match /orders/{orderId} {
      // Customer can read their own orders; Admin can read all orders
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      // Customer can create an order for themselves if not blocked
      allow create: if isAuthenticated() && 
        isNotBlocked() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.orderStatus == 'Pending';
      // Only Admin can update order status or details
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // COUPONS COLLECTION
    match /coupons/{couponId} {
      allow read: if true; // Customers need to read active coupons for application
      allow create, update, delete: if isAdmin();
    }

    // NEWSLETTER SUBSCRIPTIONS
    match /newsletterSubscriptions/{subId} {
      allow create: if true; // Anyone can subscribe
      allow read, update, delete: if isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }
  }
}
